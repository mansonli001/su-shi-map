{
  "id": "C023",
  "title": "点绛唇·醉漾轻舟",
  "author": "苏轼",
  "type": "词",
  "year": 1078,
  "route_id": "R08",
  "location": "徐州",
  "paragraphs": [
    "醉漾轻舟，信流引到花深处。",
    "尘缘相误，无计花间住。",
    "烟水茫茫，回首斜阳暮。",
    "山无数，乱红如雨，不记来时路。"
  ],
  "background": "元丰元年（1078年）在徐州作。",
  "famousQuotes": [
