{
  "id": "S121",
  "title": "次韵陈海州书怀",
  "author": "苏轼",
  "type": "诗",
  "year": 1086,
  "route_id": "R13",
  "location": "汴京",
  "paragraphs": [
    "陈海州才，风流太守。",
    "书怀一醉，风雨散来。",
    "此心安处，便是吾乡。",
    "人生如朝露，日夜消枯萎。"
  ],
  "background": "元祐元年（1086年）次韵陈海州。",
  "famousQuotes": [
    "此心安处，便是吾乡。"
  ]
}