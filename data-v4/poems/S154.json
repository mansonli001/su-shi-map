{
  "id": "S154",
  "title": "次韵子由三首",
  "author": "苏轼",
  "type": "诗",
  "year": 1098,
  "route_id": "R18",
  "location": "儋州",
  "paragraphs": [
    "子由才子，风流太守。",
    "三首诗来，字字珠玑。",
    "相逢一醉，风雨散来。",
    "此心安处，便是吾乡。"
  ],
  "background": "元符元年（1098年）次韵苏辙。",
