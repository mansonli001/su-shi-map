{
  "id": "C025",
  "title": "减字木兰花·晓来风细",
  "author": "苏轼",
  "type": "词",
  "year": 1078,
  "route_id": "R08",
  "location": "徐州",
  "paragraphs": [
    "晓来风细，不会鹊声来报喜。",
    "却将旧恨，付与新诗。",
    "彩笔新题，字字珠玑句句奇。",
    "殷勤说与，此意正合东坡意。"
  ],
  "background": "元丰元年（1078年）在徐州作。",
  "famousQuotes": [
