{
  "id": "S119",
  "title": "次韵黄鲁直见赠古风二首",
  "author": "苏轼",
  "type": "诗",
  "year": 1086,
  "route_id": "R13",
  "location": "汴京",
  "paragraphs": [
    "黄鲁直才，风流才子。",
    "见赠古风，字字珠玑。",
    "相逢一醉，风雨散来。",
    "此心安处，便是吾乡。"
  ],
  "background": "元祐元年（1086年）次韵黄庭坚古风。",
  "famousQuotes": [
    "见赠古风，字字珠玑。"
  ]
}