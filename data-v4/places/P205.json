      "essence": "太湖田园栖居理想范本之地",
      "su_shi_story": "深入宜兴乡间，沉醉太湖烟水、田园阡陌、古村巷陌，\n彻底向往这种远离官场、与世无争的江南田园生活。\n",
      "historical_context": "太湖西岸山水田园胜地，溪山环抱、村落连片，兼具湖光与乡野之美。\n",
      "order_in_route": 9,
      "layer": "main",
      "priority": "P0"
    },
    "R12": {
      "duration": "1085年奉旨北上启程",
      "duration_years": [
        1085
      ],
      "essence": "海疆行旅始发原点、仕途转运起点",
      "su_shi_story": "割舍江南田园归隐心愿，辞别宜兴山水，\n踏上重新起用、奔赴登州的北上宦途。\n",
      "historical_context": "太湖西岸田园胜地，苏轼原本心念归隐之地，一朝奉旨重启仕途，自此北上海疆。\n",
      "order_in_route": 1,
      "layer": "main",
      "priority": "P0"
    }
