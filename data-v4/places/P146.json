    "R19": {
      "duration": "1101年金山自题画像、渡江入江南",
      "duration_years": [],
      "essence": "一生绝笔诞生地、北人江南最后渡江门户",
      "su_shi_story": "抵润州登金山寺，自题画像并作绝笔《自题金山画像》：\n「心似已灰之木，身如不系之舟。问汝平生功业，黄州惠州儋州」，\n以一首二十八字将一生功业熔于三段贬谪之名，举重若轻、自我盖棺；\n随即自润州横渡长江，踏入心念一生的江南腹地。\n",
      "historical_context": "长江渡江门户，金山寺所在文脉圣地，是苏轼一生绝笔诗诞生地。\n",
      "order_in_route": 17,
      "layer": "main",
      "priority": "P0"
    }
