    "R11": {
      "duration": "1084年漫步凭吊",
      "duration_years": [
        1084
      ],
      "essence": "涵养苏轼冲淡怀古情怀、超脱功名执念的江南人文古地",
      "su_shi_story": "缓步秦淮岸畔，看流水千年不改、六朝繁华烟消云散，\n不做悲古伤今的哀叹，只生功名富贵皆为过眼云烟的淡然体悟，\n心境愈发超脱仕途荣辱，看淡朝堂得失纷争。\n",
      "historical_context": "金陵六朝文脉核心腹地，古桥古巷、画舫楼台、陵阙遗迹沿水排布，\n一水承载六朝更迭、千年繁华起落，人文底蕴绵长淡雅，无悲壮苍凉，只剩岁月静好的沧桑余韵。\n",
      "order_in_route": 16,
      "layer": "surrounding",
      "priority": "P1"
    }
  },
