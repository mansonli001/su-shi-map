    "R12": {
      "duration": "1085年五日太守履职驻留",
      "duration_years": [
        1085
      ],
      "essence": "本路线终点、五日太守宦迹核心地、滨海文学创作圣地",
      "su_shi_story": "抵达蓬莱就任登州知州，仅五日勤政亲民、巡察海防，\n空余大把时光登临仙阁、观沧海海市，留下千古诗文。\n",
      "historical_context": "北宋京东东路海疆重镇，海防门户、东海仙境，蓬莱仙阁坐落于此。\n",
      "order_in_route": 5,
      "layer": "main",
      "priority": "P0"
    },
    "R13": {
      "duration": "1085年奉诏离任启程",
      "duration_years": [
        1085
      ],
      "essence": "还朝路线起点、海疆宦迹终点",
      "su_shi_story": "辞别蓬莱阁沧海仙景，放下滨海闲游之乐，\n遵诏整装西向，奔赴京师重返朝堂。\n",
      "historical_context": "北宋海疆重镇，苏轼五日太守任所，奉诏离任，为西进还朝起点。\n",
      "order_in_route": 1,
      "layer": "main",
      "priority": "P0"
    }
