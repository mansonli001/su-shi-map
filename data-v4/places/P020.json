    "R06": {
      "duration": "1071年 官道南行经停、与苏辙相聚",
      "duration_years": [
        1071
      ],
      "essence": "南下中转、兄弟相聚驿点",
      "su_shi_story": "离京首站抵达陈州，与时任陈州州学教授的弟弟苏辙相聚多日，\n随后兄弟二人同往颍州拜谒欧阳修。\n",
      "historical_context": "中原东南门户，南北官道必经驿城，苏轼赴任途中与苏辙在此相聚。\n",
      "order_in_route": 2,
      "layer": "main",
      "priority": "P1"
    },
    "R10": {
      "duration": "1080年南下途经中转",
      "duration_years": [
        1080
      ],
      "essence": "中原南下江淮首个驿道中转",
      "su_shi_story": "贬途南行首抵陈州，远离京师政治漩涡，\n心境渐趋沉静，前路奔赴江汉荒远之地。\n",
      "historical_context": "汴京南下淮西古道首站重镇，中原通往江淮必经驿道节点。\n",
      "order_in_route": 2,
      "layer": "main",
      "priority": "P1"
    },
    "R16": {
      "duration": "1091年南下途经中转",
      "duration_years": [
        1091
      ],
      "essence": "中原入淮西古道中转驿点",
      "su_shi_story": "沿古驿道南行，渐离京师城郭，\n步入淮西平野河川地带，心境日渐松弛。\n",
      "historical_context": "汴京南下颍州必经古道重镇，中原入淮西过渡要地。\n",
      "order_in_route": 2,
      "layer": "main",
      "priority": "P1"
    },
    "R14": {
      "duration": "1089年江淮驿道途经",
      "duration_years": [
        1089
      ],
      "essence": "中原过渡江淮首个水乡驿点",
      "su_shi_story": "离京首站驻足，渐离京师尘嚣，\n步入江淮水乡阡陌，心境渐趋清宁。\n",
      "historical_context": "汴京南下江淮首驿重镇，水乡陂湖密布，为中原入江淮门户。\n",
      "order_in_route": 2,
      "layer": "main",
      "priority": "P1"
    }
