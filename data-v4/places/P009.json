      "essence": "元祐文坛中枢、苏轼文臣身份核心地标",
      "su_shi_story": "入职翰林院执掌文史、草拟制诰、品评文苑，\n身居天下文人之首，主持文风导向、梳理文史典籍，\n确立北宋文坛宗主地位。\n",
      "historical_context": "北宋文臣最高文史机构，掌国史编撰、朝制草拟、文人甄选，\n天下文宗荟萃之地，元祐文坛核心中枢。\n",
      "order_in_route": 14,
      "layer": "surrounding",
      "priority": "P0"
    }
