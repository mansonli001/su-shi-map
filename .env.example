# 高德地图 JSAPI Key（必需）
# 申请地址：https://console.amap.com/dev/key/app
# 需勾选"Web端(JS API)"，域名白名单配置你的域名
NEXT_PUBLIC_AMAP_KEY=your_amap_js_api_key_here

# 高德地图 Web服务 Key 的 JS Code（必需，用于 _AMapService 代理）
# 在高德控制台 → 应用管理 → 找到对应 Key → Web服务密钥(JS Code)
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# Supabase（二期，暂不配置）
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
