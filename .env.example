# =================================================================
# 高德地图配置（必需，env-only fail-fast，禁止硬编码 fallback）
# =================================================================
# 申请：https://console.amap.com/dev/key/app
# 控制台 → 应用管理 → Web端(JS API) → 配置域名白名单
#   开发：localhost
#   生产：starfluxes.com / xingxing.starfluxes.com 等子域 + *.vercel.app
# =================================================================

# 高德 JSAPI Key（前端必需，浏览器侧加载地图用）
NEXT_PUBLIC_AMAP_KEY=your_amap_js_api_key_here

# 高德 securityJsCode（浏览器加载 JSAPI 必需）
# 注意：next.js 只将 NEXT_PUBLIC_* 暴露到浏览器，因此此值需暴露给前端
# 配域名白名单后即使暴露也只能在你的域名生效
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# 高德 securityJsCode（服务端备份，用于 _AMapService 代理 / API route）
# 一般与上面的 NEXT_PUBLIC_AMAP_SECURITY_JS_CODE 同值
AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here

# Supabase（二期，暂不配置）
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
