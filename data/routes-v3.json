    "route05": {
      "route_id": "route05",
      "route_name": "第四次出蜀赴京",
      "start_date": "熙宁元年（1068年）十一二月",
      "end_date": "熙宁二年（1069年）二月初",
      "description": "熙宁元年十一月底、十二月初，苏轼为父苏洵守丧期满后，携家眷从眉山出发，第四次出蜀赴京。经过益昌(昭化)、凤翔、长安，约于熙宁二年二月初抵达汴京。居南园，除判官告院兼判尚书祠部。",
      "place_ids": [
