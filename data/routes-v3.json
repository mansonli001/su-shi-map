    "route01": {
      "route_id": "route01",
      "route_name": "第一次出蜀赴京",
      "start_date": "嘉祐元年（1056年）三月",
      "end_date": "嘉祐二年（1057年）四月",
      "description": "嘉祐元年三月，三苏从眉州出发，沿蜀道出蜀，经成都、阆中、剑门关、利州、凤翔、长安、渑池，五六月到汴京。嘉祐二年三月科举及第，四月奔母丧归蜀。",
      "place_ids": [
        "meishan",
