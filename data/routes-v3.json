    "route06": {
      "route_id": "route06",
      "route_name": "任杭州倅",
      "start_date": "熙宁四年（1071年）七月上旬",
      "end_date": "熙宁四年（1071年）十一月二十八日",
      "description": "熙宁四年七月上旬，苏轼离京赴陈州，拜访张方平、会见苏辙。后顺颍河南下至颍州，拜望退隐的欧阳修。再顺颍河、淮河、运河南下，途经寿州、扬州、润州、常州、苏州，十一月二十八日抵达杭州任通判。",
      "place_ids": [
        "bianjing",
        "chengzhou",
