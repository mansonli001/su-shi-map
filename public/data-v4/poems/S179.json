{
  "id": "S179",
  "title": "次韵林子中见寄",
  "author": "苏轼",
  "type": "诗",
  "year": 1101,
  "route_id": "R19",
  "location": "常州",
  "paragraphs": [
    "林子中才，风流太守。",
    "见寄书来，消息依稀。",
    "相逢一醉，风雨散来。",
    "此心安处，便是吾乡。"
  ],
  "background": "建中靖国元年（1101年）次韵林子中。",
  "famousQuotes": [
    "此心安处，便是吾乡。"
  ]
}