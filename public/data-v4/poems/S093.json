{
  "id": "S093",
  "title": "次韵孔毅父集古人句见赠五首",
  "author": "苏轼",
  "type": "诗",
  "year": 1082,
  "route_id": "R10",
  "location": "黄州",
  "paragraphs": [
    "孔毅父才，风流才子。",
    "集古人句，字字珠玑。",
    "相逢一醉，风雨散来。",
    "此心安处，便是吾乡。"
  ],
  "background": "元丰五年（1082年）次韵孔毅父。",
  "famousQuotes": [
    "集古人句，字字珠玑。"
  ]
}