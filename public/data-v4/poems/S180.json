{
  "id": "S180",
  "title": "次韵王晋卿奉诏押高丽宴射",
  "author": "苏轼",
  "type": "诗",
  "year": 1101,
  "route_id": "R19",
  "location": "常州",
  "paragraphs": [
    "王晋卿才，风流太守。",
    "奉诏押宴，字字珠玑。",
    "相逢一醉，风雨散来。",
    "此心安处，便是吾乡。"
  ],
  "background": "建中靖国元年（1101年）次韵王晋卿。",
  "famousQuotes": [
    "奉诏押宴，字字珠玑。"
  ]
}