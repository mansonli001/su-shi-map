      "su_shi_story": "终抵定州就任，身处北疆边关，\n理政安民、整饬边防，闲暇怀古登太行，\n北地苍茫与身世感慨相融。\n",
      "historical_context": "北宋北疆重镇，中山古国故地，南依太行、北临平原，边防与人文兼备。\n",
      "order_in_route": 9,
      "layer": "main",
      "priority": "P0"
    },
    "R18": {
      "duration": "1094年远贬启程原点",
      "duration_years": [],
      "essence": "万里远贬始发原点、仕途命运终极转折",
      "su_shi_story": "从北疆定州踏上贬途，心知前路万里蛮荒，\n坦然受命、淡然启程，开启人生最远行旅。\n",
      "historical_context": "北宋北疆重镇，苏轼仕途最后外放起点，自此开启万里南迁远贬之路。\n",
      "order_in_route": 1,
