  "global_works": [
    {
      "title": "六月二十七日望湖楼醉书五首",
      "type": "诗",
      "description": "黑云翻墨未遮山，白雨跳珠乱入船。",
      "poem_id": "S022"
    },
    {
      "title": "次韵子由送赵㞦",
      "type": "诗",
      "description": "若见故人问消息，为言春色在湖边。",
      "poem_id": "S024"
    },
    {
      "title": "吉祥寺赏牡丹",
      "type": "诗",
      "description": "人老簪花不自羞，花应羞上老人头。",
      "poem_id": "S025"
    },
    {
      "title": "吉祥寺僧求阁名",
      "type": "诗",
      "description": "尚有清欢那可负，此生端合老烟波。",
      "poem_id": "S026"
    },
    {
      "title": "冬至日独游吉祥寺",
      "type": "诗",
      "description": "何人更似苏夫子，不是花时肯独来。",
      "poem_id": "S027"
    },
    {
      "title": "吉祥寺题壁",
      "type": "诗",
      "description": "寂寞吉祥寺，风流老东坡。",
      "poem_id": "S028"
    },
    {
      "title": "雨中游天竺灵感观音院",
      "type": "诗",
      "description": "蚕欲老，麦半黄，前山后山雨浪浪。",
      "poem_id": "S029"
    }
  ],
