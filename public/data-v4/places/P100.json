  "periods": [
    {
      "period": "渡海赴儋州·途经澄迈",
      "startYear": 1097,
      "endYear": 1097,
      "narrative": "苏轼从惠州再贬儋州，在澄迈渡海。这是他第一次渡海去海南，心中充满恐惧。他在澄迈写下『澄迈滨海，风涛可畏』，但想想『反正都死了好几次了，怕什么』，毅然登船。"
    },
    {
      "period": "从儋州北归·途经澄迈",
      "startYear": 1100,
      "endYear": 1100,
      "narrative": "苏轼从儋州获赦北归，再次途经澄迈渡海回大陆。这一次，他心中充满感激：『老天爷让我活着离开海南，此生无憾。』"
    }
  ],
