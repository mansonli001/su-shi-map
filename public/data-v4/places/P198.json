    "R06": {
      "duration": "1071年 长江北岸驻留",
      "duration_years": [
        1071
      ],
      "essence": "渡江前核心枢纽",
      "su_shi_story": "驻足扬州，休整待渡，遥望江南烟水，心生向往。\n",
      "historical_context": "江淮都会，运河与长江交汇枢纽，南北咽喉。\n",
      "order_in_route": 7,
      "layer": "main",
      "priority": "P0"
    },
    "R07": {
      "duration": "1074年渡江驻留观览",
      "duration_years": [
        1074
      ],
      "essence": "南北分界、淮东门户名城",
      "su_shi_story": "渡江抵达扬州，览淮左名都风物，\n由江南温婉转入淮东苍茫地貌。\n",
      "historical_context": "江北第一都会，长江淮河交汇重镇，历代诗文名胜之地。\n",
      "order_in_route": 6,
      "layer": "main",
      "priority": "P0"
    },
    "R09": {
      "duration": "1078年江北运河中转",
      "duration_years": [
        1078
      ],
      "essence": "江北江南渡江核心枢纽",
      "su_shi_story": "驻足扬州休整，筹备渡江入江南，\n再临淮左名都，重览江北盛景。\n",
      "historical_context": "长江北岸运河枢纽，南北渡江必经名都。\n",
      "order_in_route": 4,
      "layer": "main",
      "priority": "P0"
    },
    "R15": {
      "duration": "1091年渡江中转",
      "duration_years": [
        1091
      ],
      "essence": "江南江北心境分界枢纽",
      "su_shi_story": "抵达扬州横渡长江，正式告别江南温婉，\n步入苏北平野湖川地带，行旅心境由柔转沉。\n",
      "historical_context": "长江北岸运河枢纽，江南入苏北分界门户。\n",
      "order_in_route": 4,
      "layer": "main",
      "priority": "P0"
    },
    "R16": {
      "duration": "1093年莅任怀古",
      "duration_years": [
        1093
      ],
      "essence": "本路线终点、淮上文怀怀古核心地",
      "su_shi_story": "抵达扬州履职，理政简静、不事繁苛，\n登临平山堂追怀前贤，寄文脉之思、忘仕途之扰。\n",
      "historical_context": "淮左名都，文脉深厚，平山堂为欧公旧迹，人文底蕴绵长。\n",
      "order_in_route": 7,
      "layer": "main",
      "priority": "P0"
    },
    "R17": {
      "duration": "1093年奉旨第八次进京启程",
      "duration_years": [
        1093
      ],
      "essence": "第八次进京、仕途命运转折起点",
      "su_shi_story": "辞别扬州淮上闲居岁月，奉诏北上赴京，\n本怀寻常朝命之心，未知时局即将巨变。\n",
      "historical_context": "淮左名都，苏轼扬州任上奉旨入朝，为第八次进京始发地。\n",
      "order_in_route": 1,
      "layer": "main",
      "priority": "P0"
    },
    "R14": {
      "duration": "1089年渡江中转",
      "duration_years": [
        1089
      ],
      "essence": "江淮收官、江南开篇渡江枢纽",
      "su_shi_story": "驻足扬州整理行装，静待渡江入江南，\n重临旧地，心生对江南山水的眷恋。\n",
      "historical_context": "江北运河名都，长江北岸渡江核心枢纽，江淮与江南分界要津。\n",
      "order_in_route": 5,
      "layer": "main",
      "priority": "P0"
    }
