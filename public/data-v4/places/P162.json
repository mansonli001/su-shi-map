  "global_works": [
    {
      "title": "宿州次韵刘泾",
      "type": "诗",
      "note": "",
      "source_route": "R08",
      "fullText": "我欲归休瑟渐希，舞雩何日著春衣。\n多情白发三千丈，无用苍皮四十围。\n晚觉文章真小技，早知富贵有危机。\n为君垂涕君知否，千古华亭鹤自飞。",
      "coreVerse": "我欲归休瑟渐希，舞雩何日著春衣。",
      "excerpt": "我欲归休瑟渐希，舞雩何日著春衣。",
      "poem_id": "S054"
    }
  ],
  "route_events": {
    "R08": {
      "duration": "1077年3-4月 沿汴河东下徐州途经",
      "duration_years": [
        1077
      ],
      "essence": "陈桥东下徐州汴河途经驿点",
      "su_shi_story": "自陈桥驿沿汴河东下赴徐州途中经宿州，\n作《宿州次韵刘泾》纪行，渐近徐州赴任。\n",
      "historical_context": "汴河东下徐州必经古道节点，皖北苏北交界重镇。\n（注：宿州在 1077 年苏轼路线中是**陈桥驿东下徐州**的途经点，\n而非传统订正版认为的\"密州南下徐州\"路径，详见专家裁决）\n",
      "order_in_route": 7,
      "layer": "main",
      "priority": "P1"
    },
    "R09": {
      "duration": "1078年运河南下途经",
      "duration_years": [
        1078
      ],
      "essence": "徐州南下首个运河驿点",
      "su_shi_story": "沿运河南下首站休整，渐离徐州平原地貌，\n步入南北运河过渡地带。\n",
      "historical_context": "徐南运河官道必经中转节点，皖北水陆要冲。\n",
      "order_in_route": 2,
      "layer": "main",
      "priority": "P1"
    }
  },
