  "global_works": [
    {
      "title": "初发嘉州",
      "type": "poem",
      "note": "水路出蜀代表诗作",
      "source_route": "R02",
      "fullText": "朝发鼓阗阗，西风猎画旃。\n故乡飘已远，往意浩无边。\n锦水细不见，蛮江清可怜。\n奔腾过佛脚，旷荡造平川。\n野市有禅客，钓台寻暮烟。\n相期定先到，久立水潺潺。",
      "coreVerse": "朝发鼓阗阗，西风猎画旃。",
      "excerpt": "朝发鼓阗阗，西风猎画旃。",
      "poem_id": "S002"
    }
  ],
