  "global_works": [
    {
      "id": "W064",
      "title": "赠王子直秀才",
      "type": "诗",
      "year": 1095,
      "route_id": "R18",
      "note": "1095 惠州（绍圣二年），赠虔州（江西赣州）处士王原（字子直，号鹤田处士），王子直专程访惠留七十日（《苏轼诗集》卷三十八）；元符三年苏轼北归途中复在虔州赣上重逢，证其为江西人。\"幅巾我欲作州民，君肯同耕谷口春\"，描绘惠州终老田园之愿。注：双专家最终一致采纳惠州说，驳回儋州说（儋州交往对象为王介石、黎子云等，无王子直踪迹）。",
      "fullText": "万里云山一破裘，杖端闲挂百钱游。\n五车书已留儿读，二顷田应为鹤谋。\n水底笙歌蛙两部，山中奴婢橘千头。\n幅巾我欲相随去，海上何人识故侯。",
      "excerpt": "万里云山一破裘，杖端闲挂百钱游。",
      "poem_id": "S144"
    }
  ],
