{
  "id": "C0111",
  "title": "清平乐",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "清平乐",
  "paragraphs": [
    "清淮蜀汴。",
    "更在江西岸。",
    "红旆到时黄叶乱。",
    "霜入梁王故苑。",
    "秋原何处携壶。",
    "停骖访古踟蹰。",
    "双庙遗风尚在，漆园傲吏应无。"
  ],
  "coreVerse": "清淮蜀汴。",
