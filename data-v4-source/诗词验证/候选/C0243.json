{
  "id": "C0243",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "海南奇宝。",
    "铸出团团如栲栳。",
    "曾到昆仑。",
    "乞得山头玉女盆。",
    "绛州王老。",
    "百岁痴顽推不倒。",
    "海口如门。",
    "一派黄流已电奔。"
  ],
  "coreVerse": "海南奇宝。",
