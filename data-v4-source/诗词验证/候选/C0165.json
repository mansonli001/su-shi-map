{
  "id": "C0165",
  "title": "菩萨蛮",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "菩萨蛮",
  "paragraphs": [
    "柳庭风静人眠昼。",
    "昼眠人静风庭柳。",
    "香汗薄衫凉。",
    "凉衫薄汗香。",
    "手红冰碗藕。",
    "藕碗冰红手。",
    "郎笑藕丝长。",
    "长丝藕笑郎。"
  ],
