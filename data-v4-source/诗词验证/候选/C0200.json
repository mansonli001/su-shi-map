{
  "id": "C0200",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "晓来风细。",
    "不会鹊声来报喜。",
    "却羡寒梅。",
    "先觉春风一夜来。",
    "香笺一纸。",
    "写尽回文机上意。",
    "欲卷重开。",
    "读遍千回与万回。"
  ],
