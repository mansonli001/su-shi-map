{
  "id": "C0063",
  "title": "定风波",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "定风波",
  "paragraphs": [
    "与客携壶上翠微。",
    "江涵秋影雁初飞。",
    "尘世难逢开口笑。",
    "年少。",
    "菊花须插满头归。",
    "酩酊但酬佳节了。",
    "云峤。",
    "登临不用怨斜晖。",
    "古往今来谁不老。",
    "多少。",
    "牛山何必更沾衣。"
  ],
  "coreVerse": "与客携壶上翠微。",
