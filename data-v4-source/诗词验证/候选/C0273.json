{
  "id": "C0273",
  "title": "千秋岁",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "千秋岁",
  "paragraphs": [
    "岛边天外。",
    "未老身先退。",
    "珠泪溅，丹衷碎。",
    "声摇苍玉佩。",
    "色重黄金带。",
    "一万里。",
    "斜阳正与长安对。",
    "道远谁云会。",
    "罪大天能盖。",
    "君命重，臣节在。",
    "新恩犹可觊。",
    "旧学终难改。",
    "吾已矣。",
    "乘桴且恁浮於海。"
  ],
  "coreVerse": "岛边天外。",
