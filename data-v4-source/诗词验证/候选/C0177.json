{
  "id": "C0177",
  "title": "人娇·满院桃花，尽是刘郎未",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "人娇",
  "paragraphs": [
    "满院桃花，尽是刘郎未见。",
    "於中更、一枝纤软。",
    "仙家日月，笑人间春晚。",
    "浓睡起，惊飞乱红千片。",
    "密意难传，羞容易变。",
    "平白地、为伊肠断。",
    "问君终日，怎安排心眼。",
    "须信道，司空自来见惯。"
  ],
  "coreVerse": "满院桃花，尽是刘郎未见。",
