{
  "id": "C0195",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "闽溪珍献。",
    "过海云帆来似箭。",
    "玉座金盘。",
    "不贡奇葩四百年。",
    "轻红酿白。",
    "雅称佳人纤手擘。",
    "骨细肌香。",
    "恰是当年十八娘。"
  ],
  "coreVerse": "闽溪珍献。",
