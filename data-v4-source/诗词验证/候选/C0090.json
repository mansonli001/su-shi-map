{
  "id": "C0090",
  "title": "南歌子·海上乘槎侣，仙人萼绿",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "南歌子",
  "paragraphs": [
    "海上乘槎侣，仙人萼绿华。",
    "飞升元不用丹砂。",
    "住在潮头来处、渺天涯。",
    "雷辊夫差国，云翻海若家。",
    "坐中安得弄琴牙。",
    "写取馀声归向、水仙夸。"
  ],
