{
  "id": "C0134",
  "title": "蝶恋花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "蝶恋花",
  "paragraphs": [
    "簌簌无风花自亸。",
    "寂寞园林，柳老樱桃过。",
    "落日多情还照坐。",
    "山青一点横云破。",
    "路尽河回千转柁。",
    "系缆渔村，月暗孤灯火。",
    "凭仗飞魂招楚些。",
    "我思君处君思我。"
  ],
  "coreVerse": "簌簌无风花自亸。",
