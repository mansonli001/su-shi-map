{
  "id": "C0072",
  "title": "南乡子",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "南乡子",
  "paragraphs": [
    "不到谢公台。",
    "明月清风好在哉。",
    "旧日髯孙何处去，重来。",
    "短李风流更上才。",
    "秋色渐摧颓。",
    "满院黄英映酒杯。",
    "看取桃花春二月，争开。",
    "尽是刘郎去后栽。"
  ],
  "coreVerse": "不到谢公台。",
