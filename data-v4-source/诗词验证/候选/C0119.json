{
  "id": "C0119",
  "title": "阮郎归",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "阮郎归",
  "paragraphs": [
    "绿槐高柳咽新蝉。",
    "薰风初入弦。",
    "碧纱窗下水沈烟。",
    "棋声惊昼眠。",
    "微雨过，小荷翻。",
    "榴花开欲然。",
    "玉盆纤手弄清泉。",
    "琼珠碎却圆。"
  ],
  "coreVerse": "绿槐高柳咽新蝉。",
