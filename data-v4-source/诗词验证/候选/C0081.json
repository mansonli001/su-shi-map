{
  "id": "C0081",
  "title": "南乡子",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "南乡子",
  "paragraphs": [
    "寒玉细凝肤。",
    "清歌一曲《倒金壶》。",
    "冶叶倡条遍相识，争如。",
    "豆蔻花梢二月初。",
    "年少即须臾。",
    "芳时偷得醉工夫。",
    "罗帐细垂银烛背，欢娱。",
    "豁得平生俊气无。"
  ],
  "coreVerse": "寒玉细凝肤。",
