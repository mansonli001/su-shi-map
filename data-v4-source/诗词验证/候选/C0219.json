{
  "id": "C0219",
  "title": "菩萨蛮",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "菩萨蛮",
  "paragraphs": [
    "娟娟侵鬓妆痕浅。",
    "双颦相媚弯如翦。",
    "一瞬百般宜。",
    "无论笑与啼。",
    "酒阑思翠被。",
    "特故腾腾地。",
    "生怕促归轮。",
    "微波先注人。"
  ],
