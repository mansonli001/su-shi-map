{
  "id": "C0253",
  "title": "虞美人",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "虞美人",
  "paragraphs": [
    "冰肌自是生来瘦。",
    "那更分飞后。",
    "日长帘暮望黄昏。",
    "及至黄昏时候、转销魂。",
    "君还知道相思苦。",
    "怎忍抛奴去。",
    "不辞迢递过关山。",
    "只恐别郎容易、见郎难。"
  ],
  "coreVerse": "冰肌自是生来瘦。",
