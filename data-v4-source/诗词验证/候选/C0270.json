{
  "id": "C0270",
  "title": "导引·帝城父老，三岁望尧心",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "导引",
  "paragraphs": [
    "帝城父老，三岁望尧心。",
    "天远玉楼深。",
    "龙颜仿佛笙箫远，肠断属车音。",
    "离宫春色琐瑶林。",
    "云阙海沈沈。",
    "遗民犹唱当时曲，秋雁起汾阴。"
  ],
  "coreVerse": "帝城父老，三岁望尧心。",
