{
  "id": "C0080",
  "title": "南乡子",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "南乡子",
  "paragraphs": [
    "天与化工知。",
    "赐得衣裳总是绯。",
    "每向华堂深处见，怜伊。",
    "两个心肠一片儿。",
    "自小便相随。",
    "绮席歌筵不暂离。",
    "苦恨人人分拆破，东西。",
    "怎得成双似旧时。"
  ],
  "coreVerse": "天与化工知。",
