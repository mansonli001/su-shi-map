{
  "id": "C0173",
  "title": "虞美人",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "虞美人",
  "paragraphs": [
    "波声拍枕长淮晓。",
    "隙月窥人小。",
    "无情汴水自东流。",
    "只载一船离恨、向西州。",
    "竹溪花浦曾同醉。",
    "酒味多於泪。",
    "谁教风鉴在尘埃。",
    "酝造一场烦恼、送人来。"
  ],
  "coreVerse": "波声拍枕长淮晓。",
