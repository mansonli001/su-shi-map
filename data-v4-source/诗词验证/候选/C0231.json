{
  "id": "C0231",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "天真雅丽。",
    "容态温柔心性慧。",
    "响亮歌喉。",
    "遏住行云翠不收。",
    "妙词佳曲。",
    "啭出新声能断续。",
    "重客多情。",
    "满劝金卮玉手擎。"
  ],
