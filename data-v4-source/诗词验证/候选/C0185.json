{
  "id": "C0185",
  "title": "桃源忆故人",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "桃源忆故人",
  "paragraphs": [
    "华胥梦断人何处。",
    "听得莺啼红树。",
    "几点蔷薇香雨。",
    "寂寞闲庭户。",
    "暖风不解留花住。",
    "片片著人无数。",
    "楼上望春归去。",
    "芳草迷归路。"
  ],
  "coreVerse": "华胥梦断人何处。",
