{
  "id": "C0181",
  "title": "诉衷情",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "诉衷情",
  "paragraphs": [
    "海棠珠缀一重重。",
    "清晓近帘栊。",
    "胭脂谁与匀淡，偏向脸边浓。",
    "看叶嫩，惜花红。",
    "意无穷。",
    "如花似叶，岁岁年年，共占春风。"
  ],
