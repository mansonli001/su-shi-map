{
  "id": "C0191",
  "title": "谒金门",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "谒金门",
  "paragraphs": [
    "秋池阁。",
    "风傍晓庭帘幕。",
    "霜叶未衰吹未落。",
    "半惊鸦喜鹊。",
    "自笑浮名情薄。",
    "似与世人疏略。",
    "一片懒心双懒脚。",
    "好教闲处著。"
  ],
  "coreVerse": "秋池阁。",
