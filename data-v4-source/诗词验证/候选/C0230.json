{
  "id": "C0230",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "双鬟绿坠。",
    "娇眼横波眉黛翠。",
    "妙舞蹁跹。",
    "掌上身轻意态妍。",
    "曲穷力困。",
    "笑倚人旁香喘喷。",
    "老大逢欢。",
    "昏眼犹能仔细看。"
  ],
  "coreVerse": "双鬟绿坠。",
