{
  "id": "C0066",
  "title": "定风波",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "定风波",
  "paragraphs": [
    "雨洗娟娟嫩叶光。",
    "风吹细细绿筠香。",
    "秀色乱侵书帙晚。",
    "帘卷。",
    "清阴微过酒尊凉。",
    "人画竹身肥拥肿。",
    "何用。",
    "先生落笔胜萧郎。",
    "记得小轩岑寂夜。",
    "廊下。",
    "月和疏影上东墙。"
  ],
  "coreVerse": "雨洗娟娟嫩叶光。",
