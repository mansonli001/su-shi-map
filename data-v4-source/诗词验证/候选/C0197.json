{
  "id": "C0197",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "玉觞无味。",
    "中有佳人千点泪。",
    "学道忘忧。",
    "一念还成不自由。",
    "如今未见。",
    "归去东园花似霰。",
    "一语相开。",
    "匹似当初本不来。"
  ],
