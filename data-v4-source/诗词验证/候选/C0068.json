{
  "id": "C0068",
  "title": "定风波",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "定风波",
  "paragraphs": [
    "月满苕溪照夜堂。",
    "五星一老斗光芒。",
    "十五年间真梦里。",
    "何事。",
    "长庚对月独凄凉。",
    "绿鬓苍颜同一醉。",
    "还是。",
    "六人吟笑水云乡。",
    "宾主谈锋谁得似。",
    "看取。",
    "曹刘今对两苏张。"
  ],
  "coreVerse": "月满苕溪照夜堂。",
