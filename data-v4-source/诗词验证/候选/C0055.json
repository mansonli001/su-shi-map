{
  "id": "C0055",
  "title": "渔家傲",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "渔家傲",
  "paragraphs": [
    "皎皎牵牛河汉女。",
    "盈盈临水无由语。",
    "望断碧云空日暮。",
    "无寻处。",
    "梦回芳草生春浦。",
    "鸟散馀花纷似雨。",
    "汀洲苹老香风度。",
    "明月多情来照户。",
    "但揽取。",
    "清光长送人归去。"
  ],
  "coreVerse": "皎皎牵牛河汉女。",
