{
  "id": "C0259",
  "title": "蝶恋花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "蝶恋花",
  "paragraphs": [
    "雨霰疏疏经泼火。",
    "巷陌秋千。",
    "犹未清明过。",
    "杏子梢头香蕾破。",
    "淡红褪白胭脂涴。",
    "苦被多情相折挫。",
    "病绪厌厌，浑似年时个。",
    "绕遍回廊还独坐。",
    "月笼云暗重门锁。"
  ],
  "coreVerse": "雨霰疏疏经泼火。",
