{
  "id": "C0071",
  "title": "南乡子",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "南乡子",
  "paragraphs": [
    "寒雀满疏篱。",
    "争抱寒柯看玉蕤。",
    "忽见客来花下坐，惊飞。",
    "蹋散芳英落酒卮。",
    "痛饮又能诗。",
    "坐客无毡醉不知。",
    "花尽酒阑春到也，离离。",
    "一点微酸已著枝。"
  ],
  "coreVerse": "寒雀满疏篱。",
