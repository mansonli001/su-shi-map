{
  "id": "C0198",
  "title": "减字木兰花",
  "author": "苏轼",
  "type": "词",
  "rhythmic": "减字木兰花",
  "paragraphs": [
    "春光亭下。",
    "流水如今何在也。",
    "岁月如梭。",
    "白首相看拟奈何。",
    "故人重见。",
    "世事年来千万变。",
    "官况阑珊。",
    "惭愧青松守岁寒。"
  ],
  "coreVerse": "春光亭下。",
